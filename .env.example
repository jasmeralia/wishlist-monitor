# Execution mode: "daemon" (poll continuously) or "once" (run and exit)
MODE=daemon

# Path to the wishlist config JSON file inside the container
CONFIG_PATH=/data/config.json

# Minutes between poll cycles (default: 10)
POLL_MINUTES=10

# SMTP email notifications (all optional — omit to disable email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_USE_SSL=false
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@example.com

# Email report theme: "dark" or "light"
EMAIL_THEME=dark

# Database path
DB_PATH=/data/wishlist_state.sqlite3

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=/data/wishlist_monitor.log
LOG_TO_STDOUT=true

# Debug dump retention
DEBUG_DUMP_PRUNE_ENABLED=true
DEBUG_DIR=/data/debug_dumps
DEBUG_DUMP_MAX_AGE_DAYS=7
LOG_PRUNE_ENABLED=true
LOG_MAX_AGE_DAYS=7
