# Example environment for native TrueNAS cron + uv deployment (Odoo #467).
# Copy to /mnt/myzmirror/wishlist-monitor/.env on the host before cutover.
# The shared truenas-cron wrapper auto-sources that path for --app
# jasmeralia/wishlist-monitor:master.
#
# Unlike the Docker Compose deployment (which mounts this dataset at /data inside
# the container), native cron runs on the host — use full /mnt paths below.

MODE=once

CONFIG_PATH=/mnt/myzmirror/wishlist-monitor/config.json
DB_PATH=/mnt/myzmirror/wishlist-monitor/wishlist_state.sqlite3
LOG_FILE=/mnt/myzmirror/wishlist-monitor/wishlist_monitor.log
DEBUG_DIR=/mnt/myzmirror/wishlist-monitor/debug_dumps

# SMTP email notifications (required for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_USE_SSL=false
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@example.com

EMAIL_THEME=dark
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_STDOUT=true

DEBUG_DUMP_PRUNE_ENABLED=true
DEBUG_DUMP_MAX_AGE_DAYS=7
LOG_PRUNE_ENABLED=true
LOG_MAX_AGE_DAYS=7

OBSERVATION_PRUNE_ENABLED=true
OBSERVATION_RETENTION_DAYS=120

PRICE_NOTIFY_THRESHOLD=20
NOTIFY_ON_AVAILABILITY_CHANGE=true
NOTIFY_ON_PRICE_INCREASE=true

# POLL_MINUTES only affects daemon mode; native cron uses schedule 7 */3 * * *
POLL_MINUTES=180
